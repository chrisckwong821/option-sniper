# Keep real keys in your shell or local secret manager. Do not commit them.
DATABENTO_LIVE_API_KEY=
DATABENTO_LIVE_OPTIONS_API_KEY=
DATABENTO_HISTORICAL_OPTIONS_API_KEY=

# Optional backward-compatible shared credentials:
# DATABENTO_OPTIONS_API_KEY=
# DATABENTO_API_KEY=

# Discord +1.2 sigma alert worker. Reset exposed bot tokens before storing them here.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
ZSCORE_ALERT_THRESHOLD=1.2

# Shared private market-data cache (leave bucket unset to disable S3).
SIGMA_S3_BUCKET=
SIGMA_S3_PREFIX=
SIGMA_S3_REGION=
# Mac only: browser login via aws login --profile option-sniper.
# Leave profile empty on EC2 so the SDK uses the instance role.
SIGMA_AWS_PROFILE=
SIGMA_RECONSTRUCTION_MAX_COST=
