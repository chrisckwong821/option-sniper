[Unit]
Description=Bounded Option Sniper history repair in an isolated container
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/sigma-tape/current/deploy/repair-history.sh production
TimeoutStartSec=600
ExecStopPost=-/usr/bin/docker stop -t 3 sigma-tape-history-repair
