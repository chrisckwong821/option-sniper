[Unit]
Description=Refresh Yesterday's Gainers after historical daily-summary access opens

[Timer]
# The historical EQUS.SUMMARY key cannot read the just-closed session at
# 20:20 ET. Retry after archival catches up, before the pre-market refresh.
OnCalendar=Tue..Sat *-*-* 00:30:00 America/New_York
OnCalendar=Tue..Sat *-*-* 01:30:00 America/New_York
OnCalendar=Tue..Sat *-*-* 02:30:00 America/New_York
OnCalendar=Tue..Sat *-*-* 03:10:00 America/New_York
Persistent=true
RandomizedDelaySec=30
Unit=option-sniper-yesterday-refresh.service

[Install]
WantedBy=timers.target
